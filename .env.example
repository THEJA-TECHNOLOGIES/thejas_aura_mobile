# Theja Aura — Client Environment Configuration Template
# Copy this file to '.env' for local configuration.
# DO NOT commit '.env' with private local settings or credentials.
# DO NOT store secrets or API keys in this file.

# Base URL of the Theja Aura backend service.
# - iOS Simulator / macOS desktop:
#     API_BASE_URL=http://127.0.0.1:8080
# - Physical iOS / Android Device:
#     localhost / 127.0.0.1 points to the device itself.
#     Set this to your host computer's reachable LAN IP on the same Wi-Fi network:
#     API_BASE_URL=http://192.168.1.100:8080
# - Production Server:
#     API_BASE_URL=https://mobileapi.theja.in
API_BASE_URL=http://127.0.0.1:8080
